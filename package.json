{
  "name": "rosix-which-rosix-girl-are-you",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WHICH ROSIX GIRL ARE YOU? \u2014 an interactive Y2K product-discovery quiz for Rosix Amuletos.",
  "scripts": {
    "dev": "vite",
    "build": "npm run images && tsc -b && vite build && node scripts/spa-fallback.mjs",
    "build:fast": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "build:single": "npm run images && tsc -b && node scripts/build-single.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
