# Absolute origin used for Open Graph / share-card URLs in index.html.
# Empty is safe: the tags fall back to working relative URLs.
#
# Set this in Vercel → Settings → Environment Variables once the real domain
# exists, e.g. VITE_SITE_ORIGIN=https://quiz.rosixamuletos.com
# (no trailing slash), then redeploy.
VITE_SITE_ORIGIN=
